{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "typeRoots": [
      "./src/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "App.tsx",
    "index.ts",
    "index.tsx",
    "src",
    "typings.d.ts"
  ],
  "exclude": [
    "node_modules",
    "server",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}